FROM golang:1.22 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/readthrough .

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /out/readthrough /usr/local/bin/readthrough
EXPOSE 9000
ENTRYPOINT ["/usr/local/bin/readthrough"]
